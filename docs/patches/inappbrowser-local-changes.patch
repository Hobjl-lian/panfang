+@InvokeArg
+class SetKeepScreenOnArgs {
+    /// true = 安装进行中：屏幕保持常亮（息屏会让系统把 App 冻住，传输就停半路）
+    var on: Boolean = false
 }
 
 /// 返回键锁开关（宿主 App 装表盘期间置 true）。
@@ -215,4 +226,50 @@
             invoke.resolve()
         }
     }
-}
+
+    /** 屏幕常亮（宿主 App 安装表盘期间用）：只加在窗口标志上，窗口销毁即失效，
+        不会出现「App 关了屏幕还亮着」。 */
+    @Command
+    fun setKeepScreenOn(invoke: Invoke) {
+        val args = invoke.parseArgs(SetKeepScreenOnArgs::class.java)
+        activity.runOnUiThread {
+            try {
+                if (args.on) {
+                    activity.window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+                } else {
+                    activity.window.clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+                }
+                invoke.resolve()
+            } catch (err: Exception) {
+                invoke.reject(err.message ?: "failed to set keep screen on")
+            }
+        }
+    }
+
+    /** 打开系统 WebView 的应用详情页（宿主 App 的版本门禁「去更新」按钮）：
+        用户在这里能找到「更新」入口，比让他自己去应用商店搜省事。
+        问不出当前 WebView 包名（API 26 以下或个别 ROM）就退回本 App 的详情页。 */
+    @Command
+    fun openWebViewSettings(invoke: Invoke) {
+        activity.runOnUiThread {
+            val pkg = runCatching {
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                    WebView.getCurrentWebViewPackage()?.packageName
+                } else {
+                    null
+                }
+            }.getOrNull() ?: activity.packageName
+            try {
+                activity.startActivity(
+                    Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
+                        data = Uri.parse("package:$pkg")
+                        addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                    }
+                )
+                invoke.resolve()
+            } catch (err: Exception) {
+                invoke.reject(err.message ?: "failed to open application details")
+            }
+        }
+    }
+}

