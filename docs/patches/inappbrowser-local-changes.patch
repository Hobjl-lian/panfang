+/// 返回键锁开关（宿主 App 装表盘期间置 true）。
+/// 插件里的 OnBackPressedCallback 是第一道闸；宿主的 MainActivity 也读这个开关做兜底
+/// （Tauri 的返回处理在「WebView 无历史可退」时会回到 Activity.onBackPressed，那条路
+/// 不经过本回调，只看得到 Activity 层）。
+object InstallBackLock {
+    @Volatile
+    var locked: Boolean = false
+
+    /// 主 WebView（插件 load 时记住），用来在拦下返回时通知前端
+    @Volatile
+    internal var webView: WebView? = null
+
+    /// 拦下一次返回后通知前端弹提示（宿主暴露的 `window.__pfBackBlocked()`）。
+    /// 用 evaluateJavascript 而不是插件 Event/Channel：宿主只需要一个「返回被拦了」的信号，
+    /// 走全局函数不必为此多加一条命令通道；失败也不影响拦返回本身。
+    fun notifyBackBlocked() {
+        val view = webView ?: return
+        view.post {
+            try {
+                view.evaluateJavascript("window.__pfBackBlocked && window.__pfBackBlocked()", null)
+            } catch (_: Exception) {
+                // 通知失败无所谓：返回已经被吞掉了
+            }
+        }
+    }
+}
