{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "盘坊",
  "version": "0.3.36",
  "identifier": "com.wristry.app",
  "build": {
    "beforeBuildCommand": "npm --prefix ui-react run build",
    "frontendDist": "../ui-react/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "盘坊",
        "width": 980,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}